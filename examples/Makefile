#
# Makefile for the Lynx Game Development SDK examples
#
# This Makefile requires GNU make.
#
# The examples are sorted into subsystem group subdirectories (games/, suzy/,
# mikey/, memory/, network/); the starter demo lynxdemo.c sits at the examples
# root. Each group holds the example .c files directly, and the generated
# .s/.o/.map/.lnx land beside them. This Makefile iterates over the groups.
#

ifneq ($(shell echo),)
  CMD_EXE = 1
endif

ifdef CMD_EXE
  NULLDEV = nul:
  DEL = -del /f
  RMDIR = rmdir /s /q
else
  NULLDEV = /dev/null
  DEL = $(RM)
  RMDIR = $(RM) -r
endif

ifdef CC65_HOME
  AS = $(CC65_HOME)/bin/ca65
  CC = $(CC65_HOME)/bin/cc65
  CL = $(CC65_HOME)/bin/cl65
  LD = $(CC65_HOME)/bin/ld65
  SP65 = $(CC65_HOME)/bin/sp65
  SPRPCK = $(CC65_HOME)/bin/sprpck
else
  AS := $(if $(wildcard ../bin/ca65*),../bin/ca65,ca65)
  CC := $(if $(wildcard ../bin/cc65*),../bin/cc65,cc65)
  CL := $(if $(wildcard ../bin/cl65*),../bin/cl65,cl65)
  LD := $(if $(wildcard ../bin/ld65*),../bin/ld65,ld65)
  SP65 := $(if $(wildcard ../bin/sp65*),../bin/sp65,sp65)
  SPRPCK := $(if $(wildcard ../bin/sprpck*),../bin/sprpck,sprpck)
endif

# --------------------------------------------------------------------------
# The examples, grouped by subsystem. lynxdemo is the starter and lives at the
# examples root; every other example is a flat .c inside its group directory.

ROOT_EXAMPLES = lynxdemo
GAMES         = breakout invaders raycaster sybil tetris
SUZY          = muldivtest spritetest spritesheet spriteslice sprpcktest spritefx suzyasync suzyasyncbench suzybench packtest fonttest fontvar textdir collision palette
MIKEY         = setbpp sndtune sfxtest sfxdemo poweroff
MEMORY        = heaptest zeropage
NETWORK       = comlynx
SDCARD_GD     = sdcardls

EXELIST = \
        $(addsuffix .lnx,$(ROOT_EXAMPLES)) \
        $(addprefix games/,$(addsuffix .lnx,$(GAMES))) \
        $(addprefix suzy/,$(addsuffix .lnx,$(SUZY))) \
        $(addprefix mikey/,$(addsuffix .lnx,$(MIKEY))) \
        $(addprefix memory/,$(addsuffix .lnx,$(MEMORY))) \
        $(addprefix network/,$(addsuffix .lnx,$(NETWORK))) \
        $(addprefix sdcard-gd/,$(addsuffix .lnx,$(SDCARD_GD)))

# --------------------------------------------------------------------------
# Generic rules

.PHONY: all mostlyclean clean install zip examples multicart-example handymusic-example

%: %.c
%: %.s

%.o: %.c
	$(CC) $(CFLAGS) -Ors --codesize 500 -T -g $<
	$(AS) $(<:.c=.s)

%.o: %.s
	$(AS) $(ASFLAGS) $<

.PRECIOUS: %.o

# The SDK libraries are split into a core archive plus opt-in subsystem
# archives (graphics, audio, compress, math) — see
# design/LYNX_SDK_LAYOUT_DESIGN.md sec. 6. cl65 resolves them automatically
# (sec. 6.6 and design/LYNX_CL65_AUTOLIBS_DESIGN.md): at the link step it
# appends the whole SDK set named by lib/lynx-sdklibs.list, in dependents-first
# / core-last order, so these examples link with no -l flags at all. ld65
# extracts only referenced modules, so subsystems an example does not touch
# contribute nothing and the .lnx is byte-identical to linking exactly the
# needed libraries. To link explicitly instead, use "cl65 --no-sdk-libs" with
# -l, or invoke ld65 directly with the dependency order from sec. 6.4.

%.lnx: %.o
	$(CL) $(LDFLAGS) -o $@ -m $(@:.lnx=.map) $^

# --------------------------------------------------------------------------
# Build-time sprite assets generated by sp65 from suzy/heart.pcx. The spritetest
# example draws the same source image in sp65's "literal" and "packed"
# encodings, so the two headers must be regenerated whenever the image or
# converter changes (see suzy/spritetest.c and doc/sp65.html sec. 6.4).

SPRITETEST_HDRS = suzy/heart_packed.h suzy/heart_literal.h

suzy/heart_packed.h: suzy/heart.pcx
	$(SP65) -r $< -c lynx-sprite,mode=packed -w $@,format=c,ident=heart_packed

suzy/heart_literal.h: suzy/heart.pcx
	$(SP65) -r $< -c lynx-sprite,mode=literal -w $@,format=c,ident=heart_literal

suzy/spritetest.o: suzy/spritetest.c $(SPRITETEST_HDRS)

# Build-time sprite-sheet assets generated from suzy/sheet.pcx (a 4-frame strip
# of 16x16 cells). Two examples consume the SAME image two ways, to contrast the
# workflows (see design/LYNX_SPRITE_SHEET_DESIGN.md and doc/sp65.html sec. 6.5):
#
#  * spritesheet.c uses the --sprite-sheet driver: one call -> one header with a
#    generated frame-pointer table (sheet_anim[]).
#  * spriteslice.c uses the manual --slice/--pop chain: one call -> four
#    standalone frame headers the program tables by hand.
#
# The frame data is byte-identical between the two; only the packaging differs.

SHEET_FRAMES = suzy/frame0.h suzy/frame1.h suzy/frame2.h suzy/frame3.h

suzy/sheet_anim.h: suzy/sheet.pcx
	$(SP65) -r $< --sprite-sheet name=$@,ident=sheet_anim,fw=16,fh=16,mode=packed

suzy/frame0.h suzy/frame1.h suzy/frame2.h suzy/frame3.h: suzy/sheet.pcx
	$(SP65) -r $< \
	  --slice  0,0,16,16 -c lynx-sprite,mode=packed -w suzy/frame0.h,format=c,ident=frame0 --pop \
	  --slice 16,0,16,16 -c lynx-sprite,mode=packed -w suzy/frame1.h,format=c,ident=frame1 --pop \
	  --slice 32,0,16,16 -c lynx-sprite,mode=packed -w suzy/frame2.h,format=c,ident=frame2 --pop \
	  --slice 48,0,16,16 -c lynx-sprite,mode=packed -w suzy/frame3.h,format=c,ident=frame3

suzy/spritesheet.o: suzy/spritesheet.c suzy/sheet_anim.h
suzy/spriteslice.o: suzy/spriteslice.c $(SHEET_FRAMES)

# --------------------------------------------------------------------------
# Build-time sprite assets for the transform tour (suzy/spritefx.c). Five
# source PCX images (four 16x16 shapes + a 5x5 marker) are drawn by
# suzy/spritefx_shapes.py and committed; sp65 compacts each shape FIVE times,
# once per action point (ax,ay), because the reference point is baked into the
# sprite data, not the SCB. That yields 20 shape headers plus the marker, all
# regenerated whenever an image or the converter changes (see suzy/spritefx.c
# and doc/sprites.html sec. 6, sec. 6.1). The action-point coordinates below
# match the ap_name[] order the program tables them in.

SPRITEFX_SHAPES = cube crystal star ball
SPRITEFX_HDRS   = $(foreach s,$(SPRITEFX_SHAPES),\
                    suzy/$(s)_tl.h suzy/$(s)_tr.h suzy/$(s)_c.h \
                    suzy/$(s)_bl.h suzy/$(s)_br.h) \
                  suzy/marker.h

# One sp65 run per shape emits its five action-point variants. Each -c converts
# the whole loaded image (no --slice, so no --pop): only the ax,ay action point
# differs between them, which is the whole point of the demo.
suzy/%_tl.h suzy/%_tr.h suzy/%_c.h suzy/%_bl.h suzy/%_br.h: suzy/%.pcx
	$(SP65) -r $< \
	  -c lynx-sprite,mode=packed,ax=0,ay=0   -w suzy/$*_tl.h,format=c,ident=$*_tl \
	  -c lynx-sprite,mode=packed,ax=15,ay=0  -w suzy/$*_tr.h,format=c,ident=$*_tr \
	  -c lynx-sprite,mode=packed,ax=8,ay=8   -w suzy/$*_c.h,format=c,ident=$*_c   \
	  -c lynx-sprite,mode=packed,ax=0,ay=15  -w suzy/$*_bl.h,format=c,ident=$*_bl \
	  -c lynx-sprite,mode=packed,ax=15,ay=15 -w suzy/$*_br.h,format=c,ident=$*_br

suzy/marker.h: suzy/marker.pcx
	$(SP65) -r $< -c lynx-sprite,mode=packed,ax=8,ay=8 -w $@,format=c,ident=marker

suzy/spritefx.o: suzy/spritefx.c $(SPRITEFX_HDRS)

# --------------------------------------------------------------------------
# sprpcktest packs two sprites offline with sprpck (tools/extern/sprpck) to show
# its BMP and SPS inputs - the formats sp65 does not read. sprpck emits the
# packed Suzy sprite-data block as a raw binary .spr (not a C array), so
# sprpckdata.s pulls each blob in with .incbin (assembled with --bin-include-dir
# so the .spr files are found beside it). See suzy/sprpcktest.c and
# doc/sprpck.html. logo.bmp is regenerated by logo.bmp.py; icon.sps is the plain
# ASCII source itself. sprpck also drops a logo.pal beside the BMP output.

SPRPCK_SPR = suzy/logo.spr suzy/icon.spr

suzy/logo.spr: suzy/logo.bmp
	$(SPRPCK) -t6 -s4 $< $@

suzy/icon.spr: suzy/icon.sps
	$(SPRPCK) -t2 -i016016 -s4 $< $@

suzy/sprpckdata.o: suzy/sprpckdata.s $(SPRPCK_SPR)
	$(AS) $(ASFLAGS) --bin-include-dir suzy $<

suzy/sprpcktest.lnx: suzy/sprpcktest.o suzy/sprpckdata.o
	$(CL) $(LDFLAGS) -o $@ -m $(@:.lnx=.map) $^

# --------------------------------------------------------------------------
# The collision demo needs the collision buffer, which only the lynx-coll.cfg
# memory layout reserves (it carves 8 KB below the screen pages; the default
# lynx.cfg leaves that RAM to the program). So this one example overrides the
# link config; every other example links with the default lynx.cfg. See
# suzy/collision.c and doc/collisions.html.

suzy/collision.lnx: suzy/collision.o
	$(CL) $(LDFLAGS) -C lynx-coll.cfg -o $@ -m $(@:.lnx=.map) $^

# --------------------------------------------------------------------------
# The snd-engine demo links the example against a compiled ABC tune stream.
# theme.s is the committed output of "abccc -f s -l theme_music -o theme.s
# theme.abc" (abccc lives under tools/abccc/, host-compiled into bin/, outside
# this build); regenerate it by hand when theme.abc changes. See mikey/sndtune.c
# and doc/sound.html.

mikey/sndtune.lnx: mikey/sndtune.o mikey/theme.o
	$(CL) $(LDFLAGS) -o $@ -m $(@:.lnx=.map) $^

# sfxtest links the hand-authored rsound effect streams in mikey/sfx.s.  sfxdemo
# needs no extra object: it plays the reusable sfx pack, whose per-effect members
# ld65 pulls out of lib/lynx-audio.lib automatically (see doc/sound.html sec. 6).

mikey/sfxtest.lnx: mikey/sfxtest.o mikey/sfx.o
	$(CL) $(LDFLAGS) -o $@ -m $(@:.lnx=.map) $^

# invaders plays the Space Invaders theme from the hand-authored snd-engine
# stream in games/invtheme.s (a re-encoding of a tune written for an earlier
# engine; see that file). It links beside the game object.

games/invaders.lnx: games/invaders.o games/invtheme.o
	$(CL) $(LDFLAGS) -o $@ -m $(@:.lnx=.map) $^

# --------------------------------------------------------------------------

examples: $(EXELIST) multicart-example handymusic-example

# The multicart example bundles a menu and several game ROMs into one cart with
# "lnx multicart" + lynxdir, so it has its own Makefile rather than the flat
# .c -> .lnx rule above. Build it from scratch alongside the rest. See
# multicart/Makefile and design/LYNX_MULTICART_DESIGN.md.
multicart-example:
	@$(MAKE) --no-print-directory -C multicart clean all

# The HandyMusic example drives the hmcc script compiler to build its music/SFX
# data blobs and links against the reserved-region cfg/lynx-handymusic.cfg, so it
# has its own Makefile rather than the flat .c -> .lnx rule above. See
# mikey/handymusic/Makefile and design/LYNX_HANDYMUSIC_DESIGN.md.
handymusic-example:
	@$(MAKE) --no-print-directory -C mikey/handymusic clean all

# The top-level Makefile invokes "make -C examples all". Always rebuild the
# examples from scratch here so that a changed toolchain, library or config is
# guaranteed to be re-exercised (the .lnx files carry no dependency on the
# library, so an incremental build would otherwise leave them stale).
all:
	@$(MAKE) --no-print-directory mostlyclean
	@$(MAKE) --no-print-directory examples

# --------------------------------------------------------------------------
# Installation rules

INSTALL = install
examplesdir = $(PREFIX)/share/cc65/examples

install:
	$(if $(PREFIX),,$(error variable "PREFIX" must be set))
	$(INSTALL) -d $(DESTDIR)$(examplesdir)
	$(INSTALL) -m0644 Makefile $(addsuffix .c,$(ROOT_EXAMPLES)) $(DESTDIR)$(examplesdir)
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/games
	$(INSTALL) -m0644 $(addprefix games/,$(addsuffix .c,$(GAMES))) $(DESTDIR)$(examplesdir)/games
	$(INSTALL) -m0644 games/invtheme.s $(DESTDIR)$(examplesdir)/games
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -m0644 $(addprefix suzy/,$(addsuffix .c,$(SUZY))) $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -m0644 suzy/heart.pcx suzy/heart.pcx.py $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -m0644 suzy/sheet.pcx suzy/sheet.pcx.py $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -m0644 suzy/sprpckdata.s suzy/logo.bmp suzy/logo.bmp.py suzy/icon.sps $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -m0644 suzy/cube.pcx suzy/crystal.pcx suzy/star.pcx suzy/ball.pcx suzy/marker.pcx suzy/spritefx_shapes.py $(DESTDIR)$(examplesdir)/suzy
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/mikey
	$(INSTALL) -m0644 $(addprefix mikey/,$(addsuffix .c,$(MIKEY))) $(DESTDIR)$(examplesdir)/mikey
	$(INSTALL) -m0644 mikey/theme.abc mikey/theme.s mikey/sfx.s $(DESTDIR)$(examplesdir)/mikey
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/mikey/handymusic
	$(INSTALL) -m0644 mikey/handymusic/Makefile mikey/handymusic/handymusic.c mikey/handymusic/hmdemo.s $(DESTDIR)$(examplesdir)/mikey/handymusic
	$(INSTALL) -m0644 mikey/handymusic/instr.txt mikey/handymusic/sfx.txt mikey/handymusic/track1.txt mikey/handymusic/track2.txt mikey/handymusic/track3.txt mikey/handymusic/track4.txt $(DESTDIR)$(examplesdir)/mikey/handymusic
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/memory
	$(INSTALL) -m0644 $(addprefix memory/,$(addsuffix .c,$(MEMORY))) $(DESTDIR)$(examplesdir)/memory
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/network
	$(INSTALL) -m0644 $(addprefix network/,$(addsuffix .c,$(NETWORK))) $(DESTDIR)$(examplesdir)/network
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/sdcard-gd
	$(INSTALL) -m0644 $(addprefix sdcard-gd/,$(addsuffix .c,$(SDCARD_GD))) $(DESTDIR)$(examplesdir)/sdcard-gd
	$(INSTALL) -d $(DESTDIR)$(examplesdir)/multicart
	$(INSTALL) -m0644 multicart/Makefile multicart/README.md multicart/menu.c multicart/game1.c multicart/game2.c multicart/game3.c $(DESTDIR)$(examplesdir)/multicart

# --------------------------------------------------------------------------
# Packaging rules

zip:
	@cd .. && zip -r cc65 examples/

# --------------------------------------------------------------------------
# Clean-up rules

mostlyclean:
	@$(DEL) $(EXELIST:.lnx=.map) $(EXELIST:.lnx=.o) $(EXELIST:.lnx=.s) $(SPRITETEST_HDRS) suzy/sheet_anim.h $(SHEET_FRAMES) $(SPRITEFX_HDRS) $(SPRPCK_SPR) suzy/sprpckdata.o suzy/logo.pal mikey/theme.o mikey/sfx.o games/invtheme.o 2>$(NULLDEV)

clean: mostlyclean
	@$(DEL) $(EXELIST) 2>$(NULLDEV)
	@$(MAKE) --no-print-directory -C multicart clean 2>$(NULLDEV) || true
	@$(MAKE) --no-print-directory -C mikey/handymusic clean 2>$(NULLDEV) || true
