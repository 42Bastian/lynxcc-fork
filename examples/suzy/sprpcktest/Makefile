#
# Makefile for the sprpcktest example.
#
# Unlike the flat suzy/ examples (one .c -> one .lnx via the top-level examples
# Makefile), sprpcktest packs two sprites offline with sprpck (tools/extern/
# sprpck) to show its BMP and SPS inputs - the formats sp65 does not read. sprpck
# emits the packed Suzy sprite-data block as a raw binary .spr (not a C array),
# so sprpckdata.s pulls each blob in with .incbin (assembled with
# --bin-include-dir . so the .spr files are found beside it). logo.bmp is
# regenerated by logo.bmp.py; icon.sps is the plain ASCII source itself. sprpck
# also drops a logo.pal beside the BMP output.
#
# See suzy/sprpcktest/sprpcktest.c and doc/sprpck.html.
#

ifdef CC65_HOME
  CC     = $(CC65_HOME)/bin/cc65
  AS     = $(CC65_HOME)/bin/ca65
  CL     = $(CC65_HOME)/bin/cl65
  SPRPCK = $(CC65_HOME)/bin/sprpck
else
  CC     := $(if $(wildcard ../../../bin/cc65*),../../../bin/cc65,cc65)
  AS     := $(if $(wildcard ../../../bin/ca65*),../../../bin/ca65,ca65)
  CL     := $(if $(wildcard ../../../bin/cl65*),../../../bin/cl65,cl65)
  SPRPCK := $(if $(wildcard ../../../bin/sprpck*),../../../bin/sprpck,sprpck)
endif

CFLAGS = -Ors --codesize 500 -T -g

TARGET = sprpcktest.lnx

SPR = logo.spr icon.spr

.PHONY: all clean
all: $(TARGET)

%.o: %.c
	$(CC) $(CFLAGS) $<
	$(AS) $(<:.c=.s)

logo.spr: logo.bmp
	$(SPRPCK) -t6 -s4 $< $@

icon.spr: icon.sps
	$(SPRPCK) -t2 -i016016 -s4 $< $@

sprpckdata.o: sprpckdata.s $(SPR)
	$(AS) --bin-include-dir . $<

$(TARGET): sprpcktest.o sprpckdata.o
	$(CL) -o $@ -m $(@:.lnx=.map) sprpcktest.o sprpckdata.o

clean:
	$(RM) sprpcktest.o sprpcktest.s sprpckdata.o $(SPR) logo.pal \
	      sprpcktest.map $(TARGET)
