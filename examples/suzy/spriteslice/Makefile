#
# Makefile for the spriteslice example.
#
# Unlike the flat suzy/ examples (one .c -> one .lnx via the top-level examples
# Makefile), spriteslice builds four standalone frame headers at build time. It
# uses the manual sp65 --slice/--pop chain: one call cuts sheet.pcx (a 4-frame
# strip of 16x16 cells, regenerated by sheet.pcx.py) into four independent frame
# headers the program tables by hand. The sibling spritesheet example consumes
# the same image the --sprite-sheet way; each keeps its own copy of sheet.pcx so
# it is self-contained. The frame data is byte-identical; only the packaging
# differs.
#
# See suzy/spriteslice/spriteslice.c, design/LYNX_SPRITE_SHEET_DESIGN.md and
# doc/sp65.html sec. 6.5.
#

ifdef CC65_HOME
  CC   = $(CC65_HOME)/bin/cc65
  AS   = $(CC65_HOME)/bin/ca65
  CL   = $(CC65_HOME)/bin/cl65
  SP65 = $(CC65_HOME)/bin/sp65
else
  CC   := $(if $(wildcard ../../../bin/cc65*),../../../bin/cc65,cc65)
  AS   := $(if $(wildcard ../../../bin/ca65*),../../../bin/ca65,ca65)
  CL   := $(if $(wildcard ../../../bin/cl65*),../../../bin/cl65,cl65)
  SP65 := $(if $(wildcard ../../../bin/sp65*),../../../bin/sp65,sp65)
endif

CFLAGS = -Ors --codesize 500 -T -g

TARGET = spriteslice.lnx

FRAMES = frame0.h frame1.h frame2.h frame3.h

.PHONY: all clean
all: $(TARGET)

%.o: %.c
	$(CC) $(CFLAGS) $<
	$(AS) $(<:.c=.s)

$(FRAMES): sheet.pcx
	$(SP65) -r $< \
	  --slice  0,0,16,16 -c lynx-sprite,mode=packed -w frame0.h,format=c,ident=frame0 --pop \
	  --slice 16,0,16,16 -c lynx-sprite,mode=packed -w frame1.h,format=c,ident=frame1 --pop \
	  --slice 32,0,16,16 -c lynx-sprite,mode=packed -w frame2.h,format=c,ident=frame2 --pop \
	  --slice 48,0,16,16 -c lynx-sprite,mode=packed -w frame3.h,format=c,ident=frame3

spriteslice.o: spriteslice.c $(FRAMES)

$(TARGET): spriteslice.o
	$(CL) -o $@ -m $(@:.lnx=.map) spriteslice.o

clean:
	$(RM) spriteslice.o spriteslice.s $(FRAMES) spriteslice.map $(TARGET)
