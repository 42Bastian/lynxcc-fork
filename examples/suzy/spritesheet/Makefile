#
# Makefile for the spritesheet example.
#
# Unlike the flat suzy/ examples (one .c -> one .lnx via the top-level examples
# Makefile), spritesheet builds a sprite-sheet header at build time. It uses the
# sp65 --sprite-sheet driver: one call turns sheet.pcx (a 4-frame strip of 16x16
# cells, regenerated by sheet.pcx.py) into one header with a generated
# frame-pointer table (sheet_anim[]). The sibling spriteslice example consumes
# the same image the manual --slice/--pop way; each keeps its own copy of
# sheet.pcx so it is self-contained.
#
# See suzy/spritesheet/spritesheet.c, design/LYNX_SPRITE_SHEET_DESIGN.md and
# doc/sp65.html sec. 6.5.
#

ifdef CC65_HOME
  CC   = $(CC65_HOME)/bin/cc65
  AS   = $(CC65_HOME)/bin/ca65
  CL   = $(CC65_HOME)/bin/cl65
  SP65 = $(CC65_HOME)/bin/sp65
else
  CC   := $(if $(wildcard ../../../bin/cc65*),../../../bin/cc65,cc65)
  AS   := $(if $(wildcard ../../../bin/ca65*),../../../bin/ca65,ca65)
  CL   := $(if $(wildcard ../../../bin/cl65*),../../../bin/cl65,cl65)
  SP65 := $(if $(wildcard ../../../bin/sp65*),../../../bin/sp65,sp65)
endif

CFLAGS = -Ors --codesize 500 -T -g

TARGET = spritesheet.lnx

.PHONY: all clean
all: $(TARGET)

%.o: %.c
	$(CC) $(CFLAGS) $<
	$(AS) $(<:.c=.s)

sheet_anim.h: sheet.pcx
	$(SP65) -r $< --sprite-sheet name=$@,ident=sheet_anim,fw=16,fh=16,mode=packed

spritesheet.o: spritesheet.c sheet_anim.h

$(TARGET): spritesheet.o
	$(CL) -o $@ -m $(@:.lnx=.map) spritesheet.o

clean:
	$(RM) spritesheet.o spritesheet.s sheet_anim.h spritesheet.map $(TARGET)
