#
# Makefile for the spritetest example.
#
# Unlike the flat suzy/ examples (one .c -> one .lnx via the top-level examples
# Makefile), spritetest draws the same source image (heart.pcx, regenerated by
# heart.pcx.py) in sp65's "literal" and "packed" encodings, so it has its own
# build to regenerate the two headers whenever the image or converter changes.
#
# See suzy/spritetest/spritetest.c and doc/sp65.html sec. 6.4.
#

ifdef CC65_HOME
  CC   = $(CC65_HOME)/bin/cc65
  AS   = $(CC65_HOME)/bin/ca65
  CL   = $(CC65_HOME)/bin/cl65
  SP65 = $(CC65_HOME)/bin/sp65
else
  CC   := $(if $(wildcard ../../../bin/cc65*),../../../bin/cc65,cc65)
  AS   := $(if $(wildcard ../../../bin/ca65*),../../../bin/ca65,ca65)
  CL   := $(if $(wildcard ../../../bin/cl65*),../../../bin/cl65,cl65)
  SP65 := $(if $(wildcard ../../../bin/sp65*),../../../bin/sp65,sp65)
endif

CFLAGS = -Ors --codesize 500 -T -g

TARGET = spritetest.lnx

HDRS = heart_packed.h heart_literal.h

.PHONY: all clean
all: $(TARGET)

%.o: %.c
	$(CC) $(CFLAGS) $<
	$(AS) $(<:.c=.s)

heart_packed.h: heart.pcx
	$(SP65) -r $< -c lynx-sprite,mode=packed -w $@,format=c,ident=heart_packed

heart_literal.h: heart.pcx
	$(SP65) -r $< -c lynx-sprite,mode=literal -w $@,format=c,ident=heart_literal

spritetest.o: spritetest.c $(HDRS)

$(TARGET): spritetest.o
	$(CL) -o $@ -m $(@:.lnx=.map) spritetest.o

clean:
	$(RM) spritetest.o spritetest.s $(HDRS) spritetest.map $(TARGET)
