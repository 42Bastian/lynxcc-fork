; CPU bitmask constants
; These mirror the CPU_ISET_* values in the toolchain (src/common/cpu.h).
; This tree only supports the Atari Lynx (65SC02), a superset of the 6502.
CPU_ISET_NONE      = $0001
CPU_ISET_6502      = $0002
CPU_ISET_65SC02    = $0004

; CPU capabilities
CPU_NONE           = CPU_ISET_NONE
CPU_6502           = CPU_ISET_6502
CPU_65SC02         = CPU_ISET_6502|CPU_ISET_65SC02
