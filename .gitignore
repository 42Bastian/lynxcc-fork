.DS_Store

# Build output directories
/bin/
/lib/
/libwrk/
/wrk/

# Compiled example artifacts (sources are *.c + Makefile). The root holds the
# lynxdemo starter; every other example lives in a group subdirectory.
examples/*.lnx
examples/*.map
examples/*.o
examples/*.s
examples/*/*.lnx
examples/*/*.map
examples/*/*.o
examples/*/*.s
# ...except the hand-authored tune/effect streams that are committed beside their
# examples (theme.s is the abccc-compiled sndtune tune; invtheme.s is the two-voice
# invaders theme extracted from the reference cartridge).
!examples/mikey/theme.s
!examples/games/invtheme.s

# sp65-generated sprite headers (rebuilt from suzy/heart.pcx)
examples/suzy/heart_packed.h
examples/suzy/heart_literal.h

# sp65-generated sprite-sheet headers (rebuilt from suzy/sheet.pcx)
examples/suzy/sheet_anim.h
examples/suzy/frame0.h
examples/suzy/frame1.h
examples/suzy/frame2.h
examples/suzy/frame3.h

# Python bytecode cache
__pycache__/

# Host-built unit-test binaries
tests/unit/bin/

# Project-template build outputs (templates/*/.gitignore also covers these)
templates/*/game.lnx
templates/*/game.map
templates/*/src/*.o
templates/*/src/*.s
