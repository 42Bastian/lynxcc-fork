.DS_Store

# Build output directories
/bin/
/lib/
/libwrk/
/wrk/

# Compiled example artifacts (sources are *.c + Makefile). The root holds the
# lynxdemo starter; every other example lives in a group subdirectory.
examples/*.lnx
examples/*.map
examples/*.o
examples/*.s
examples/*/*.lnx
examples/*/*.map
examples/*/*.o
examples/*/*.s
# ...except the hand-authored tune/effect streams that are committed beside their
# examples (theme.s is the abccc-compiled sndtune tune; invtheme.s is the two-voice
# invaders theme extracted from the reference cartridge; sprpckdata.s is the
# .incbin glue that embeds sprpck's binary .spr output for sprpcktest).
!examples/mikey/theme.s
!examples/games/invtheme.s
!examples/suzy/sprpckdata.s

# sp65-generated sprite headers (rebuilt from suzy/heart.pcx)
examples/suzy/heart_packed.h
examples/suzy/heart_literal.h

# sprpck-generated sprite/palette assets (rebuilt from suzy/logo.bmp + icon.sps)
examples/suzy/logo.spr
examples/suzy/icon.spr
examples/suzy/logo.pal

# sp65-generated sprite-sheet headers (rebuilt from suzy/sheet.pcx)
examples/suzy/sheet_anim.h
examples/suzy/frame0.h
examples/suzy/frame1.h
examples/suzy/frame2.h
examples/suzy/frame3.h

# sp65-generated action-point sprite headers (rebuilt from the spritefx PCX
# shapes: 5 variants per shape + the marker; see suzy/spritefx.c)
examples/suzy/cube_tl.h
examples/suzy/cube_tr.h
examples/suzy/cube_c.h
examples/suzy/cube_bl.h
examples/suzy/cube_br.h
examples/suzy/crystal_tl.h
examples/suzy/crystal_tr.h
examples/suzy/crystal_c.h
examples/suzy/crystal_bl.h
examples/suzy/crystal_br.h
examples/suzy/star_tl.h
examples/suzy/star_tr.h
examples/suzy/star_c.h
examples/suzy/star_bl.h
examples/suzy/star_br.h
examples/suzy/ball_tl.h
examples/suzy/ball_tr.h
examples/suzy/ball_c.h
examples/suzy/ball_bl.h
examples/suzy/ball_br.h
examples/suzy/marker.h

# Python bytecode cache
__pycache__/

# Host-built unit-test binaries
tests/unit/bin/

# Project-template build outputs (templates/*/.gitignore also covers these)
templates/*/game.lnx
templates/*/game.map
templates/*/src/*.o
templates/*/src/*.s
